# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/house-of-virasat

# Security & JWT (Generate strong 32+ character secrets)
JWT_SECRET=supersecretjwtsecretkey_atleast32charslong_12345
JWT_REFRESH_SECRET=supersecretrefreshjwtsecretkey_atleast32charslong_12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (wildcard '*' or comma-separated list of origins, e.g. https://houseofvirasat.in,http://localhost:5173)
CORS_ORIGIN=*

# Payment - Razorpay
RAZORPAY_KEY_ID=rzp_test_samplekeyid
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=sample_razorpay_webhook_secret

# Logistics - Shiprocket
SHIPROCKET_EMAIL=shipping@houseofvirasat.com
SHIPROCKET_PASSWORD=sample_shiprocket_password

# Email Notifications
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_sample_resend_api_key
BREVO_API_KEY=
AWS_SES_REGION=
EMAIL_FROM=noreply@houseofvirasat.com

# Storage — Cloudflare R2
# All product/category/bespoke images are stored in R2 (S3-compatible)
# Files are processed in-memory (Sharp → WebP buffer) then uploaded directly to R2.
# No images are written to VPS disk.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=house-of-virasat-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# Or with custom domain:
# R2_PUBLIC_URL=https://cdn.houseofvirasat.com

# UPLOADS_DIR is no longer used for image storage (kept for legacy compat)
UPLOADS_DIR=./uploads
