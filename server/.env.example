# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/house-of-virasat

# Security & JWT (Generate strong 32+ character secrets)
JWT_SECRET=supersecretjwtsecretkey_atleast32charslong_12345
JWT_REFRESH_SECRET=supersecretrefreshjwtsecretkey_atleast32charslong_12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (wildcard '*' or comma-separated list of origins, e.g. https://houseofvirasat.in,http://localhost:5173)
CORS_ORIGIN=*

# Payment - Razorpay
RAZORPAY_KEY_ID=rzp_test_samplekeyid
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=sample_razorpay_webhook_secret

# Logistics - Shiprocket
SHIPROCKET_EMAIL=shipping@houseofvirasat.com
SHIPROCKET_PASSWORD=sample_shiprocket_password

# Email Notifications
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_sample_resend_api_key
BREVO_API_KEY=
AWS_SES_REGION=
EMAIL_FROM=noreply@houseofvirasat.com

# Storage & CDN
# Development — relative path, server itself acts as CDN
UPLOADS_DIR=./uploads
CDN_BASE_URL=http://localhost:5000

# Production VPS — use absolute path + your domain or CDN origin
# UPLOADS_DIR=/var/www/houseofvirasat/uploads
# CDN_BASE_URL=https://api.houseofvirasat.com
#
# Upload folder layout (auto-created on server start):
#   uploads/
#   ├── temp/                        ← multer drop zone (auto-cleaned every hour)
#   ├── products/{year}/{month}/     ← product gallery images
#   ├── bespoke/{year}/{month}/      ← bespoke reference images
#   ├── categories/{year}/{month}/   ← category banners
#   ├── collections/{year}/{month}/  ← collection banners
#   ├── content/{year}/{month}/      ← content block images
#   └── settings/{year}/{month}/     ← logo, OG images, branding
#
# VPS backup (rsync example):
#   rsync -avz /var/www/houseofvirasat/uploads/ backup@YOUR_BACKUP_SERVER:/backups/uploads/

